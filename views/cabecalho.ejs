
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Fórmula 1</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        body {
            max-width: 1150px;
            min-height: 100vh;
            margin: 0 auto;
            padding: 30px;
            background: #101014;
            color: #eeeeee;
            font-family: Arial, sans-serif;
        }

        /* CABEÇALHO */

        .topo {
            background: #19191f;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #303038;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }

        .marca {
            padding: 35px 30px;
            border-bottom: 5px solid #e10600;
        }

        .marca h1 {
            margin: 0;
            color: #ffffff;
            font-size: 34px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .marca p {
            margin: 5px 0 0;
            color: #aaaaaa;
            font-size: 12px;
            letter-spacing: 4px;
        }

        /* MENU */

        .menu {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 14px 20px;
            background: #222229;
        }

        .menu a {
            padding: 10px 18px;
            color: #eeeeee;
            text-decoration: none;
            font-weight: bold;
            border-radius: 5px;
            transition: 0.3s;
        }

        .menu a:hover {
            background: #e10600;
            color: white;
        }

        /* TÍTULOS */

        h2, h3 {
            margin: 25px 0 18px;
            color: #ffffff;
            font-weight: bold;
        }

        h2 {
            padding-left: 12px;
            border-left: 5px solid #e10600;
        }

        p {
            color: #bbbbbb;
        }

        /* CONTEÚDO */

        body > div {
            margin-top: 25px;
            padding: 30px;
            background: #1b1b22;
            border: 1px solid #303038;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        /* LINKS */

        a {
            color: #ff3b35;
            text-decoration: none;
        }

        a:hover {
            color: #ff7772;
        }

        /* TABELAS */

        table {
            width: 100%;
            margin: 20px 0;
            border-collapse: collapse;
            background: #202027;
            color: #eeeeee;
        }

        th {
            padding: 15px;
            background: #e10600;
            color: white;
            text-align: left;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #383840;
            color: #eeeeee;
            background: #202027;
        }

        tr:hover td {
            background: #303038;
        }

        /* FORMULÁRIOS */

        form {
            max-width: 760px;
            margin-top: 24px;
        }

        form p {
            margin: 18px 0 6px;
            color: #eeeeee;
            font-weight: bold;
        }

        input, select, textarea {
            display: block;
            width: 100%;
            min-height: 44px;
            padding: 10px;
            border: 1px solid #44444d;
            border-radius: 6px;
            background: #292930;
            color: white;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #e10600;
            box-shadow: 0 0 0 3px rgba(225, 6, 0, 0.2);
            background: #303038;
            color: white;
        }

        input::placeholder, textarea::placeholder {
            color: #aaaaaa;
        }

        textarea {
            min-height: 100px;
        }

        /* BOTÕES */

        button, .btn {
            padding: 10px 22px;
            margin: 20px 8px 0 0;
            border: 1px solid #e10600;
            border-radius: 6px;
            background: #e10600;
            color: white;
            font-weight: bold;
            transition: 0.3s;
        }

        button:hover, .btn:hover {
            background: #a00000;
            border-color: #a00000;
            color: white;
        }

        button[type="reset"] {
            background: #303038;
            color: white;
            border-color: #55555e;
        }

        button[type="reset"]:hover {
            background: #44444d;
        }

        /* RODAPÉ */

        footer {
            margin-top: 40px;
            padding: 22px;
            border-top: 4px solid #e10600;
            background: #19191f;
            color: #aaaaaa;
            text-align: center;
            border-radius: 8px;
        }

        /* CELULAR */

        @media (max-width: 640px) {

            body {
                padding: 15px;
            }

            .marca {
                padding: 25px 18px;
            }

            .marca h1 {
                font-size: 25px;
            }

            .menu {
                gap: 4px;
                padding: 10px;
            }

            .menu a {
                padding: 9px 12px;
                font-size: 14px;
            }

            body > div {
                padding: 16px;
            }

            table {
                display: block;
                overflow-x: auto;
            }

        }

    </style>
</head>

<body>

    <header class="topo">

        <div class="marca">
            <h1>FÓRMULA 1</h1>
            <p>SISTEMA DE GERENCIAMENTO</p>
        </div>

        <nav class="menu">
            <a href="/">Início</a>
            <a href="/piloto">Pilotos</a>
            <a href="/equipe">Equipes</a>
            <a href="/circuito">Circuitos</a>
        </nav>

    </header>