
<%- include('../cabecalho') %>

<div>
    <a href="/circuito">Voltar</a>

    <h3>Alterar Circuito</h3>

    <form method="POST">

        <p>Nome</p>
        <input type="text" name="nome" value="<%= circuito.nome %>" required>

        <p>País</p>
        <input type="text" name="pais" value="<%= circuito.pais %>" required>

        <p>Cidade</p>
        <input type="text" name="cidade" value="<%= circuito.cidade %>" required>

        <p>Extensão (km)</p>
        <input type="number" step="0.001" name="extensao" value="<%= circuito.extensao %>">

        <p>Número de voltas</p>
        <input type="number" name="voltas" value="<%= circuito.voltas %>">

        <p>Recorde da volta</p>
        <input type="text" name="recorde" value="<%= circuito.recorde %>">

        <button type="submit">Salvar Alterações</button>
        <button type="reset">Cancelar</button>

    </form>
</div>

<%- include('../rodape') %>
