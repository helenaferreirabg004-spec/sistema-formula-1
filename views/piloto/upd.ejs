
<%- include('../cabecalho') %>

<div>
    <a href="/piloto">Voltar</a>

    <h3>Alterar Piloto</h3>

    <form method="POST">

        <input type="hidden" name="id" value="<%= piloto.id %>">

        <p>Nome</p>
        <input type="text" name="nome" value="<%= piloto.nome %>" required>

        <p>Nacionalidade</p>
        <input type="text" name="nacionalidade" value="<%= piloto.nacionalidade %>" required>

        <p>Idade</p>
        <input type="number" name="idade" value="<%= piloto.idade %>">

        <p>Número</p>
        <input type="number" name="numero" value="<%= piloto.numero %>" required>

        <p>Equipe</p>
        <input type="text" name="equipe" value="<%= piloto.equipe %>" required>

        <button type="submit">Salvar Alterações</button>
        <button type="reset">Cancelar</button>

    </form>
</div>

<%- include('../rodape') %>
