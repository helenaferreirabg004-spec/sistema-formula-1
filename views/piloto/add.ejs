
<%- include('../cabecalho') %>

<div>
    <a href="/piloto">Voltar</a>

    <h3>Novo Piloto</h3>

    <form action="/piloto/add" method="POST">

        <p>Nome</p>
        <input type="text" name="nome" placeholder="Nome do piloto..." required>

        <p>Nacionalidade</p>
        <input type="text" name="nacionalidade" placeholder="Nacionalidade..." required>

        <p>Idade</p>
        <input type="number" name="idade">

        <p>Número</p>
        <input type="number" name="numero" required>

        <p>Equipe</p>
        <input type="text" name="equipe" placeholder="Nome da equipe..." required>

        <br>

        <button type="submit">Adicionar</button>
        <button type="reset">Cancelar</button>

    </form>
</div>

<%- include('../rodape') %>
